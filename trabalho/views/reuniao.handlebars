<section id="popup-age" class="desactive">
        <div id="div-popup-age">
            <p id="fecharAge">X</p>
            <form action="/age" method="post">
                <h2>Nome do compromisso</h2>
                <input type="text" name="nomeage" id="nomeage" required maxlength="30">
                <h2>Data</h2>
                <input type="date" name="datage" id="datage">
                <h2>Hora</h2>
                <input type="time" name="horage" id="horage">
                <h2>O que será abordado?</h2>
                <textarea name="aborage" id="aborage" placeholder="Insira uma pequena descrição sobre o assunto"></textarea>
                <button type="submit">Enviar</button>
            </form>
        </div>
    </section>
<header>
    <a href="/"><img src="/casa.png" alt="home" class="bTnhome"></a>
    <h1>Agenda</h1>
    <button id="bTnAge">Registrar agendamento</button>   
</header>

<main id="mainAge"> 
    {{#each postage}}
    <div class="postAge">
        <h2>{{titulo_agenda}}</h2>
        <p data-data="{{data_agenda}}" class="datagedata"></p>
        <p data-hora="{{hora_agenda}}" class="datagehora"></p>
        <p><span class="negrito">O que será abordado:</span> {{descricao_agenda}}</p>
    <a href="/del4/{{idagenda}}"><button>deletar</button></a>
    </div>
    {{/each}}
</main>
<script src="/age.js"></script>