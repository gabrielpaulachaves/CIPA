<section id="popup-oco" class="desactive">
    <div id="div-popup-oco">
        <p id="fecharoco">X</p>
            <form action="/oco" method="post">
                <h2>Nome do relator</h2>
                <input type="text" name="nomeoco" id="nomeoco" class="form-control" required maxlength="100">
                <h2>Data do ocorrido</h2>
                <input type="date" name="dataoco" class="form-control">
                <h2>Setor do ocorrido</h2>
                <input type="text" name="setoroco" id="setoroco" class="form-control" required maxlength="30">
                <h2>Título da ocorrência</h2> <!-- no DB ela é da coluna descrição -->
                <textarea name="descoco" id="descoco" class="form-control" required></textarea>
                <h2>Nível do ocorrido</h2>
                <select name="niveloco" id="niveloco" class="form-select">
                    <option value="baixo">baixo</option>
                    <option value="medio">médio</option>
                    <option value="alto">alto</option>
                </select>
                <h2>Status da ocorrência</h2>
                <select name="statusoco" id="statusoco" class="form-select">
                    <option value="aberto">aberto</option>
                    <option value="em andamento">em andamento</option>
                    <option value="resolvido">resolvido</option>
                </select>
                <h2>Descrição da ocorrência</h2> <!-- no DB ela é da coluna observacao-->
                <textarea name="obsoco" id="obsoco" class="form-control" required></textarea>
                <button class="btn btn-success">enviar</button>
        </div>
</section>
<header id="headerOco">
    <a href="/"><img src="/casa.png" alt="home" class="bTnhome"></a>
    <h1>Ocorrências</h1>
    <button id="bTnOco" class="btn">Registrar ocorrência</button>
    </form>
</header>
<main id="mainOco"> 
    {{#each postoco}}
    <div class="postOco">
        <p><span class="negrito">id:</span> {{idocorrencia}}</p>
        <h2>{{descricao_ocorrencia}}</h2>
        <p><span class="negrito">Acionador:</span> {{nome_acionador}}</p>
        <p class="data-data" data-data="{{data}}"></p>
        <p><span class="negrito">Local:</span> {{setor_ocorrencia}}</p>    
        <p><span class="negrito">Nível:</span> {{nivel}} </p>
        <p><span class="negrito">Status atual:</span> <span id="spanstatus" data-value="{{status_ocorrencia}}">{{status_ocorrencia}}</span></p>
        <form action="/alterstatusoco" method="post">
        <input type="hidden" name="idoco" value="{{idocorrencia}}">
            <select name="alterstatusoco" id="alterstatusoco" class="form-select form-select-sm">
            <option value="aberto">aberto</option>
            <option value="em andamento">em andamento</option>
            <option value="resolvido">resolvido</option>
            </select>
            <button class="btn btn-sm btn-outline-success">Salvar alterações</button>
        </form>
        <p><span class="negrito">descrição:</span> {{observacao}}</p>
    <a href="/del3/{{idocorrencia}}"><button class="btn btn-sm">deletar</button></a>
    </div>
    {{/each}}
</main>
<script src="/oco.js"></script>
